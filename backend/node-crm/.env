JWT_EXPIRES_IN=7d

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# Velox eSIM platform (external service on :5000) — must match Velox CRM_API_KEY
VELOX_API_URL=http://localhost:5000
