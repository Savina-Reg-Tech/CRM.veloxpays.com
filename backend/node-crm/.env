# Server
PORT=5001
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
CRM_BRIDGE_ENABLED=true
JWT_SECRET=89890912937465789
JWT_EXPIRES_IN=7d

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# Velox eSIM platform (external service on :5000) — must match Velox CRM_API_KEY
VELOX_API_URL=http://localhost:5000
VELOX_API_KEY=8ee2087fb9766370e03f2f59c295e7a496d87b5bf9077335e051f27c0199f289

# ── VeloxVerse Admin Bridge ──────────────────────────────────────
# Base URL of the VeloxVerse backend API (with prefix).
VELOXVERSE_API_URL=http://localhost:5005/api/v1
VELOXVERSE_BRIDGE_EMAIL_MAP=admin@crm.com:admin@veloxverse.com,superadmin@crm.com:superadmin@veloxverse.com

# Email — real Gmail account (same one VeloxVerse's backend uses, see
# veloxverse/backend/.env EMAIL/EMAIL_PASSWORD). Powers admin-triggered
# password-reset notifications (notificationService.js -> mailer.js) and the
# self-service "Forgot password" OTP emails (passwordResetService.js).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=anshuman@remitso.com
SMTP_PASS=qoao nkvn tzfs qgms
MAIL_FROM=Velox CRM <anshuman@remitso.com>

# Same Gmail account for emailService.js (Form Builder submission notifications).
MAIL_USER=anshuman@remitso.com
MAIL_APP_PASSWORD=qoao nkvn tzfs qgms
