# Server
PORT=5001
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm_db
DB_USER=postgres
DB_PASSWORD=your_password_here
# SSL is ON unless this is "false". A local Postgres has no SSL; managed Postgres requires it,
# so leave it unset (or remove this line) in production.
DB_SSL=false

# JWT — signs every CRM session and is the key VeloxVerse trusts for the admin bridge (set
# VeloxVerse's CRM_JWT_SECRET to the same value). Generate with: openssl rand -hex 32
# With NODE_ENV=production the server refuses to start if this is under 32 characters or is
# still a placeholder.
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Session cookie `Secure` flag (HTTPS only). Defaults to ON when NODE_ENV=production and OFF
# otherwise — leave unset in production. Set false only where the site is served over plain
# http (local docker on http://localhost).
# COOKIE_SECURE=

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# How many proxies / load balancers sit in front of this API. The rate limits (login, password
# reset codes, public forms) key on the client address, so this must be exact:
#   0 = the API is reached directly (local dev, plain docker compose)
#   1 = one load balancer in front (default when unset)
# Too low and every user shares the balancer's address; too high and a client can spoof its
# address with X-Forwarded-For and bypass the limits. A comma-separated list of proxy
# addresses / subnets also works.
TRUST_PROXY=0

# Velox eSIM platform = the VeloxVerse backend itself (GET /api/crm/customers[/:id]) — same
# host/port as VELOXVERSE_API_URL below (VeloxVerse runs on :5005 by default). Must match
# VeloxVerse's CRM_CUSTOMERS_API_KEY (veloxverse/backend/.env).
VELOX_API_URL=http://localhost:5005
VELOX_API_KEY=velox-crm-secret-change-this-to-something-random

# ── Document storage ─────────────────────────────────────────
# Used for BOTH Verification Documents (KYC) and Form Builder file-upload
# fields — both features share this same storage adapter/bucket.
# ── Document storage (verification documents + Form Builder file uploads) ──
# Leave S3_BUCKET empty to use local disk — fine for development only. In production the
# server's own disk is wiped on every deploy/restart, so uploaded documents would be lost.
# Set these to store documents in a PRIVATE S3 bucket (files are only ever handed out as
# short-lived signed links, after the CRM has checked who is asking).
# Verify the setup with:  npm run storage:check
S3_BUCKET=
# The bucket's region (must match exactly, e.g. ap-south-1).
AWS_REGION=us-east-1
# Access key of an IAM user that may only Put/Get/Delete objects in this one bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional folder inside the bucket, with a trailing slash (e.g. crm/). Keys below it are
#   verification/user-<id>/<doc>-<uuid>.pdf   and   form-submissions/<formId>/<uuid>.pdf
S3_PREFIX=
# How long a download link stays valid, in seconds.
S3_SIGNED_URL_TTL=300
# Only for S3-compatible stores (MinIO etc.) — leave empty for AWS.
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true

# Local fallback directory (when S3_BUCKET is empty):
STORAGE_LOCAL_DIR=uploads
# With NODE_ENV=production and no S3_BUCKET, new uploads are REFUSED (503) so documents are
# never written to a disk the next deploy wipes. Set true only if STORAGE_LOCAL_DIR is a
# persistent volume (the docker compose stack does this).
# ALLOW_LOCAL_STORAGE=true

# ── Email (notifications) ────────────────────────────────────
# One transport for every email (password-reset OTPs, notifications, Form Builder
# submissions). SMTP is used when SMTP_HOST is set; otherwise the Gmail app password
# below. With neither, emails are only logged — and in production "Forgot password"
# answers 503 instead of claiming a code was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Velox CRM <no-reply@velox-crm.local>

# Gmail account + app password — used for ALL email when SMTP_HOST is empty.
MAIL_USER=
MAIL_APP_PASSWORD=

# ── Verification expiry sweep ────────────────────────────────
# In-process daily scheduler; set EXPIRY_CRON_DISABLED=true to run it
# externally via `docker compose run --rm expire` instead.
EXPIRY_CRON_DISABLED=false
EXPIRY_CRON_SCHEDULE=0 2 * * *
# Purge file bytes from storage on expiry (metadata is always retained):
EXPIRY_PURGE_FILES=false

# ── VeloxVerse Admin Bridge ──────────────────────────────────────
# Base URL of the VeloxVerse backend API (with prefix).
VELOXVERSE_API_URL=http://localhost:5005/api/v1
# Map CRM admin email → VeloxVerse admin email for audit FK columns (updated_by, etc.).
# Use one global override OR per-email pairs (not both required).
# Optional extra check on the bridge token ("iss" / "aud" claims). Switch on ONLY together with
# VeloxVerse's CRM_JWT_ISSUER / CRM_JWT_AUDIENCE, on the same day — once VeloxVerse has them
# configured it refuses tokens without them.
# VELOXVERSE_BRIDGE_ISSUER=velox-crm
# VELOXVERSE_BRIDGE_AUDIENCE=veloxverse
# VELOXVERSE_BRIDGE_USER_EMAIL=admin@veloxverse.com
VELOXVERSE_BRIDGE_EMAIL_MAP=admin@crm.com:admin@veloxverse.com,superadmin@crm.com:superadmin@veloxverse.com
