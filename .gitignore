# ── Environment files (contain secrets) ──────────────────────
# Every .env variant, in every directory (.env, .env.local, .env.production, …)
.env
.env.*
*.env

# ── OS noise ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Local document storage (S3 used in production) ───────────
backend/node-crm/uploads/
uploads/

# ── Dependencies (installed from package-lock.json; never committed) ──
node_modules/

# ── Build output / caches ────────────────────────────────────
dist/
*.tsbuildinfo
