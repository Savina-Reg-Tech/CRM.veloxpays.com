# ── Environment files (contain secrets) ──────────────────────
.env
.env.local
.env.*.local
# Production / per-environment settings (live credentials) — never commit
.env.production
.env.production.*
.env.staging
backend/node-crm/.env.production
# …but the documented templates stay tracked
!.env.example
!**/.env.example
backend/node-crm/.env

# ── OS noise ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Local document storage (S3 used in production) ───────────
backend/node-crm/uploads/
uploads/

# ── Dependencies (installed from package-lock.json; never committed) ──
node_modules/

# ── Build output / caches ────────────────────────────────────
dist/
*.tsbuildinfo
